<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee          http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">
    <display-name>AUTOCARE</display-name>
    <!-- Report Servlet -->
    <servlet>
        <servlet-name>ReportServlet</servlet-name>
        <servlet-class>controller.ReportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReportServlet</servlet-name>
        <url-pattern>/reports</url-pattern>
    </servlet-mapping>
    <!-- Revenue Report Servlet -->
    <servlet>
        <servlet-name>RevenueReportServlet</servlet-name>
        <servlet-class>controller.RevenueReportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RevenueReportServlet</servlet-name>
        <url-pattern>/revenueReport</url-pattern>
    </servlet-mapping>
    <!-- Payment Report Servlet -->
    <servlet>
        <servlet-name>PaymentReportServlet</servlet-name>
        <servlet-class>controller.PaymentReportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PaymentReportServlet</servlet-name>
        <url-pattern>/paymentReport</url-pattern>
    </servlet-mapping>
    
    <!-- Mechanic Performance Report Servlet -->
<servlet>
    <servlet-name>MechanicReportServlet</servlet-name>
    <servlet-class>controller.MechanicReportServlet</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>MechanicReportServlet</servlet-name>
    <url-pattern>/mechanicReport</url-pattern>
</servlet-mapping>
    
    <!-- Welcome Page -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>
